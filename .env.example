# ─────────────────────────────────────────────────────────────
# CodeVerse environment variables
# Only DATABASE_URL and BETTER_AUTH_SECRET are REQUIRED.
# Every other key is optional — the app falls back gracefully.
# ─────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL (free: https://neon.tech → New project → Connection string, "Pooled")
DATABASE_URL="postgresql://USER:PASSWORD@HOST/codeverse?sslmode=require"

# REQUIRED — random 32+ char secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Social login (optional — buttons are hidden when missing)
# Google: https://console.cloud.google.com/apis/credentials  (redirect: {APP_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers → OAuth Apps (callback: {APP_URL}/api/auth/callback/github)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email via Resend (optional — emails are printed to the server console when missing)
# https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="CodeVerse <onboarding@resend.dev>"

# Code execution via Judge0 CE (optional — the console shows "add your Judge0 key" when missing)
# Development: RapidAPI https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_RAPIDAPI_KEY=""
JUDGE0_RAPIDAPI_HOST="judge0-ce.p.rapidapi.com"
# Production: self-hosted Judge0 (see README) — takes precedence over RapidAPI
JUDGE0_URL=""
JUDGE0_AUTH_TOKEN=""

# AI tutor (optional — a mocked streaming tutor is used when missing)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Search (optional — Postgres full-text search is used when missing)
MEILISEARCH_HOST=""
MEILISEARCH_API_KEY=""

# Realtime via Pusher Channels (optional — polling is used when missing)
# https://dashboard.pusher.com → Channels app → App keys
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# Media via Cloudinary (optional — files are stored in public/uploads when missing)
# https://console.cloudinary.com → Dashboard → API environment variable
CLOUDINARY_URL=""

