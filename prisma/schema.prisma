// CodeVerse — full data model
// Better Auth tables: User, Session, Account, Verification

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  STUDENT
  CONTRIBUTOR
  ADMIN
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  SCHEDULED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum LessonType {
  ARTICLE
  VIDEO
  PROBLEM
  QUIZ
}

enum Language {
  C
  CPP
  JAVA
  PYTHON
  JAVASCRIPT
  GO
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  INTERNAL_ERROR
}

enum SubmissionKind {
  RUN
  SUBMIT
  PLAYGROUND
}

enum SheetKind {
  TOPIC
  COMPANY
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
}

enum ContestStatus {
  UPCOMING
  LIVE
  ENDED
}

enum VoteTarget {
  COMMENT
  DOUBT
  ANSWER
  ARTICLE
}

enum CommentTarget {
  ARTICLE
  PROBLEM
  LESSON
}

enum NotificationType {
  SYSTEM
  ACHIEVEMENT
  CONTEST
  COMMENT
  FOLLOW
  REVIEW
  ANNOUNCEMENT
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportTarget {
  ARTICLE
  COMMENT
  DOUBT
  ANSWER
  USER
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum XpSource {
  ARTICLE_READ
  PROBLEM_SOLVED
  STREAK_BONUS
  QUIZ_PASSED
  CONTEST
  COURSE_COMPLETED
  BADGE
  ADMIN
}

enum ContributorAppStatus {
  PENDING
  APPROVED
  REJECTED
}

// ───────────────────────────── Auth (Better Auth) ─────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          Role      @default(STUDENT)
  username      String?   @unique
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  isPro         Boolean   @default(false)
  lastActiveAt  DateTime?

  sessions  Session[]
  accounts  Account[]
  profile   Profile?
  streak    Streak?
  followers Follow[]  @relation("following")
  following Follow[]  @relation("follower")

  articles          Article[]            @relation("ArticleAuthor")
  articleRevisions  ArticleRevision[]
  reviewedArticles  Article[]            @relation("ArticleReviewer")
  submissions       Submission[]
  enrollments       Enrollment[]
  progress          Progress[]
  bookmarks         Bookmark[]
  notes             Note[]
  flashcards        Flashcard[]
  comments          Comment[]
  votes             Vote[]
  doubts            Doubt[]
  answers           Answer[]
  badges            UserBadge[]
  xpEvents          XpEvent[]
  certificates      Certificate[]
  notifications     Notification[]
  reports           Report[]             @relation("Reporter")
  subscriptions     Subscription[]
  payments          Payment[]
  quizAttempts      QuizAttempt[]
  contestEntries    ContestParticipant[]
  auditLogs         AuditLog[]
  reviews           Review[]
  snippets          Snippet[]
  media             Media[]
  contributorApps   ContributorApplication[]
  announcements     Announcement[]
  studySessions     StudySession[]
  articleLikes      ArticleLike[]

  @@index([role])
  @@index([createdAt])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────────── Social ─────────────────────────────

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  college         String?
  country         String?
  location        String?
  website         String?
  github          String?
  linkedin        String?
  xp              Int      @default(0)
  level           Int      @default(1)
  contestRating   Int      @default(1500)
  maxRating       Int      @default(1500)
  preferredLang   Language @default(PYTHON)
  locale          String   @default("en")
  theme           String   @default("dark")
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)
  weeklyDigest       Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([xp])
  @@index([contestRating])
  @@index([college])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// ───────────────────────────── Courses ─────────────────────────────

model Course {
  id           String       @id @default(cuid())
  slug         String       @unique
  title        String
  subtitle     String
  description  String
  topic        String
  level        Level        @default(BEGINNER)
  language     String       @default("English")
  isPro        Boolean      @default(false)
  priceInr     Int          @default(0)
  thumbnail    String?
  color        String       @default("#7C3AED")
  durationMins Int          @default(0)
  status       ContentStatus @default(PUBLISHED)
  featured     Boolean      @default(false)
  outcomes     String[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  modules      Module[]
  enrollments  Enrollment[]
  reviews      Review[]
  certificates Certificate[]
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags         Tag[]

  @@index([topic])
  @@index([level])
  @@index([status])
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  lessons   Lesson[]
  createdAt DateTime @default(now())

  @@index([courseId, order])
}

model Lesson {
  id           String     @id @default(cuid())
  moduleId     String
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug         String
  title        String
  type         LessonType @default(ARTICLE)
  order        Int
  durationMins Int        @default(10)
  isPreview    Boolean    @default(false)
  content      String?
  videoUrl     String?
  articleId    String?
  article      Article?   @relation(fields: [articleId], references: [id], onDelete: SetNull)
  problemId    String?
  problem      Problem?   @relation(fields: [problemId], references: [id], onDelete: SetNull)
  quizId       String?
  quiz         Quiz?      @relation(fields: [quizId], references: [id], onDelete: SetNull)
  progress     Progress[]
  comments     Comment[]
  createdAt    DateTime   @default(now())

  @@unique([moduleId, slug])
  @@index([moduleId, order])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPct Int       @default(0)
  completedAt DateTime?
  lastLessonId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([userId, lessonId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int
  body      String
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

// ───────────────────────────── Articles ─────────────────────────────

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  order       Int       @default(0)
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  articles    Article[]
  courses     Course[]
}

model Tag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  articles Article[]
  courses  Course[]
  doubts   Doubt[]
}

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String
  content        String
  difficulty     Difficulty    @default(EASY)
  status         ContentStatus @default(DRAFT)
  isBlog         Boolean       @default(false)
  order          Int           @default(0)
  readingMins    Int           @default(5)
  views          Int           @default(0)
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  reviewNote     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  authorId    String
  author      User          @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewerId  String?
  reviewer    User?         @relation("ArticleReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        Tag[]
  revisions   ArticleRevision[]
  lessons     Lesson[]
  comments    Comment[]
  bookmarks   Bookmark[]
  notes       Note[]
  likes       ArticleLike[]
  quizzes     Quiz[]

  @@index([status, publishedAt])
  @@index([categoryId, order])
  @@index([authorId])
}

model ArticleLike {
  userId    String
  articleId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, articleId])
}

model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  message   String?
  version   Int
  createdAt DateTime @default(now())

  @@unique([articleId, version])
}

// ───────────────────────────── Problems ─────────────────────────────

model Problem {
  id            String     @id @default(cuid())
  slug          String     @unique
  number        Int        @unique
  title         String
  statement     String
  constraints   String
  inputFormat   String?
  outputFormat  String?
  difficulty    Difficulty
  topics        String[]
  companies     String[]
  hints         String[]
  editorial     String?
  starterCode   Json
  solutionCode  Json?
  timeLimitMs   Int        @default(2000)
  memoryLimitMb Int        @default(256)
  isPremium     Boolean    @default(false)
  status        ContentStatus @default(PUBLISHED)
  totalSubmissions Int     @default(0)
  totalAccepted    Int     @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  testCases       TestCase[]
  submissions     Submission[]
  sheetItems      SheetItem[]
  contestProblems ContestProblem[]
  lessons         Lesson[]
  comments        Comment[]
  bookmarks       Bookmark[]

  @@index([difficulty])
  @@index([status])
}

model TestCase {
  id        String   @id @default(cuid())
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input     String
  expected  String
  isSample  Boolean  @default(false)
  explanation String?
  order     Int      @default(0)

  @@index([problemId, isSample])
}

model Submission {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId  String?
  problem    Problem?       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contestId  String?
  contest    Contest?       @relation(fields: [contestId], references: [id], onDelete: SetNull)
  language   Language
  code       String
  kind       SubmissionKind @default(SUBMIT)
  verdict    Verdict        @default(PENDING)
  passed     Int            @default(0)
  total      Int            @default(0)
  runtimeMs  Int?
  memoryKb   Int?
  results    Json?
  createdAt  DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([problemId, verdict])
  @@index([contestId])
}

model Snippet {
  id        String   @id @default(cuid())
  shareId   String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String   @default("Untitled snippet")
  language  Language
  code      String
  stdin     String?
  createdAt DateTime @default(now())
}

// ───────────────────────────── Sheets ─────────────────────────────

model Sheet {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  kind        SheetKind   @default(TOPIC)
  company     String?
  isPublished Boolean     @default(true)
  items       SheetItem[]
  createdAt   DateTime    @default(now())
}

model SheetItem {
  id        String  @id @default(cuid())
  sheetId   String
  sheet     Sheet   @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  section   String
  order     Int

  @@unique([sheetId, problemId])
  @@index([sheetId, order])
}

model Roadmap {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  nodes       Json
  edges       Json
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────── Quizzes ─────────────────────────────

model Quiz {
  id              String     @id @default(cuid())
  slug            String     @unique
  title           String
  description     String
  topic           String
  durationMins    Int        @default(15)
  negativeMarking Boolean    @default(false)
  negativeMark    Float      @default(0.25)
  isMockTest      Boolean    @default(false)
  isPro           Boolean    @default(false)
  isPublished     Boolean    @default(true)
  articleId       String?
  article         Article?   @relation(fields: [articleId], references: [id], onDelete: SetNull)
  questions       Question[]
  attempts        QuizAttempt[]
  lessons         Lesson[]
  createdAt       DateTime   @default(now())
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType @default(SINGLE)
  prompt      String
  options     String[]
  correct     Int[]
  explanation String
  marks       Int          @default(1)
  order       Int

  @@index([quizId, order])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  quizId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers    Json
  score      Float
  maxScore   Float
  correct    Int
  wrong      Int
  skipped    Int
  timeTakenS Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([quizId, score])
}

// ───────────────────────────── Contests ─────────────────────────────

model Contest {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String
  startsAt     DateTime
  endsAt       DateTime
  frozen       Boolean       @default(false)
  freezeAt     DateTime?
  ratingsApplied Boolean     @default(false)
  isPublished  Boolean       @default(true)
  problems     ContestProblem[]
  participants ContestParticipant[]
  submissions  Submission[]
  createdAt    DateTime      @default(now())

  @@index([startsAt])
}

model ContestProblem {
  contestId String
  problemId String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  points    Int     @default(100)
  order     Int

  @@id([contestId, problemId])
}

model ContestParticipant {
  id           String   @id @default(cuid())
  contestId    String
  userId       String
  contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score        Int      @default(0)
  penaltyMins  Int      @default(0)
  solved       Int      @default(0)
  rank         Int?
  /// Snapshot taken when the leaderboard is frozen (public standings until the contest ends)
  frozenScore   Int?
  frozenPenalty Int?
  frozenSolved  Int?
  ratingBefore Int?
  ratingAfter  Int?
  registeredAt DateTime @default(now())

  @@unique([contestId, userId])
  @@index([contestId, score])
}

// ───────────────────────────── Learning tools ─────────────────────────────

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  problemId String?
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@unique([userId, problemId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  highlight String?
  body      String
  color     String   @default("purple")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model Flashcard {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  front        String
  back         String
  sourceSlug   String?
  easeFactor   Float    @default(2.5)
  intervalDays Int      @default(0)
  repetitions  Int      @default(0)
  dueAt        DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId, dueAt])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutes   Int
  date      DateTime @db.Date

  @@unique([userId, date])
}

// ───────────────────────────── Community ─────────────────────────────

model Comment {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  target     CommentTarget
  articleId  String?
  article    Article?      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  problemId  String?
  problem    Problem?      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  lessonId   String?
  lesson     Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[]     @relation("Replies")
  body       String
  score      Int           @default(0)
  hidden     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([articleId, createdAt])
  @@index([problemId, createdAt])
  @@index([parentId])
}

model Vote {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType VoteTarget
  targetId   String
  value      Int
  createdAt  DateTime   @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Doubt {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  body             String
  score            Int      @default(0)
  views            Int      @default(0)
  hidden           Boolean  @default(false)
  acceptedAnswerId String?  @unique
  acceptedAnswer   Answer?  @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  answers          Answer[] @relation("DoubtAnswers")
  tags             Tag[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
  @@index([score])
}

model Answer {
  id         String   @id @default(cuid())
  doubtId    String
  doubt      Doubt    @relation("DoubtAnswers", fields: [doubtId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  score      Int      @default(0)
  hidden     Boolean  @default(false)
  acceptedOn Doubt?   @relation("AcceptedAnswer")
  createdAt  DateTime @default(now())

  @@index([doubtId, score])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTarget
  targetId   String
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  resolvedBy String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

model ContributorApplication {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertise  String
  sample     String
  portfolio  String?
  status     ContributorAppStatus @default(PENDING)
  createdAt  DateTime             @default(now())

  @@index([status])
}

// ───────────────────────────── Gamification ─────────────────────────────

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String
  tier        BadgeTier   @default(BRONZE)
  color       String      @default("#7C3AED")
  criteria    Json
  xpReward    Int         @default(50)
  users       UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@id([userId, badgeId])
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    XpSource
  amount    Int
  refId     String?
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, source, refId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Streak {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  current       Int       @default(0)
  longest       Int       @default(0)
  freezes       Int       @default(1)
  lastActiveDay DateTime? @db.Date
  updatedAt     DateTime  @updatedAt
}

model Certificate {
  id         String   @id @default(cuid())
  code       String   @unique
  userId     String
  courseId   String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt   DateTime @default(now())

  @@unique([userId, courseId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

// ───────────────────────────── Monetization ─────────────────────────────

model Plan {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String
  priceInr      Int
  interval      BillingInterval @default(MONTHLY)
  features      String[]
  isActive      Boolean         @default(true)
  razorpayPlanId String?
  subscriptions Subscription[]
  createdAt     DateTime        @default(now())
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  cancelledAt      DateTime?
  payments         Payment[]
  createdAt        DateTime           @default(now())

  @@index([userId, status])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  amountInr         Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  provider          String        @default("mock")
  providerOrderId   String?       @unique
  providerPaymentId String?
  createdAt         DateTime      @default(now())

  @@index([status, createdAt])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  percentOff  Int
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  payments    Payment[]
  createdAt   DateTime  @default(now())
}

// ───────────────────────────── Platform ─────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  link      String?
  variant   String   @default("info")
  isBanner  Boolean  @default(true)
  isActive  Boolean  @default(true)
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([isActive, startsAt])
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String
  value       Json?
  updatedAt   DateTime @updatedAt
}

model Media {
  id         String   @id @default(cuid())
  url        String
  publicId   String?
  filename   String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  uploaderId String?
  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  userId    String?
  device    String   @default("desktop")
  country   String   @default("IN")
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
}
